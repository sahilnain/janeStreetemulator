# pe_regs (v2 map): IMEM write protection, strobes only for their address, no
# config change without a write, writes only affect their register, address
# auto-increment, imem_err and STATUS2 stickiness, irq equation.
[tasks]
default
d1024_p16

[options]
mode prove
depth 4

[engines]
smtbmc yices

[script]
read -formal -DPE_REGS_TOP pe_regs.v
d1024_p16: chparam -set IMEM_DEPTH 1024 -set NUM_PINS 16 -set FIFO_CW 3 pe_regs
prep -top pe_regs

[files]
../src/host/pe_regs.v
