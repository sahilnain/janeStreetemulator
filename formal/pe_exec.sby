# pe_exec (combinational): held instructions have no side effects, side
# effects only from their own op, pc/stall/C rules, `out`/`in` bit
# conservation in both shift directions. Exhaustive (all inputs).
[tasks]
default
p16_sr12

[options]
mode prove
depth 1

[engines]
smtbmc yices

[script]
read -formal -DPE_EXEC_TOP pe_exec.v
default: chparam -set AW 6 -set NUM_PINS 8 -set SR_W 16 -set DATA_W 8 -set CTR_W 16 pe_exec
p16_sr12: chparam -set AW 8 -set NUM_PINS 16 -set SR_W 12 -set DATA_W 6 -set CTR_W 12 pe_exec
prep -top pe_exec

[files]
../src/core/pe_exec.v
