# pe_imem (flop implementation): for a solver-chosen address, memory holds
# the last written value and a read returns it one cycle later.
# The latch implementation (IMPL=1) is proved with `multiclock on`: clk is
# a free signal toggling every solver step, so latch open/close timing is
# modelled exactly (depth counts half-cycles there).
[tasks]
d64
d16_w32
latch_d16 latch
latch_d64 latch

[options]
mode prove
~latch: depth 4
latch: depth 10
latch: multiclock on

[engines]
smtbmc yices

[script]
read -formal pe_imem.v
d64: chparam -set IW 24 -set DEPTH 64 -set IMPL 0 pe_imem
d16_w32: chparam -set IW 32 -set DEPTH 16 -set IMPL 0 pe_imem
latch_d16: chparam -set IW 24 -set DEPTH 16 -set IMPL 1 pe_imem
latch_d64: chparam -set IW 24 -set DEPTH 64 -set IMPL 1 pe_imem
prep -top pe_imem

[files]
../src/mem/pe_imem.v
