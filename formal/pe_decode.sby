# pe_decode (combinational): every field is the documented slice, and exactly
# the reserved opcodes are illegal. Exhaustive over all 32-bit words.
[tasks]
aw6
aw10

[options]
mode prove
depth 1

[engines]
smtbmc yices

[script]
read -formal pe_decode.v
aw6: chparam -set AW 6 pe_decode
aw10: chparam -set AW 10 pe_decode
prep -top pe_decode

[files]
../src/core/pe_decode.v
