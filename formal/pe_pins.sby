# pe_pins: open-drain never drives high; a pin only changes on a hit of an allowed
# port; at most one port per pin; busy rule; owner_err semantics; reset state.
# Includes pe_sync's own properties.
[tasks]
p8
p16
p4

[options]
mode prove
depth 6

[engines]
smtbmc yices

[script]
read -formal -DPE_PINS_TOP pe_pins.v
read -formal pe_sync.v
p8: chparam -set NUM_PINS 8 pe_pins
p16: chparam -set NUM_PINS 16 pe_pins
p4: chparam -set NUM_PINS 4 pe_pins
prep -top pe_pins

[files]
../src/io/pe_pins.v
../src/io/pe_sync.v
