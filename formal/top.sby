# tt_um_sahil_protoemu: the whole chip with every module's properties, all
# internal contracts asserted (only the host-bus protocol on the pins is
# assumed). See the header of the formal block in the top level.
[tasks]
prf
cvr

[options]
prf: mode prove
prf: depth 6
cvr: mode cover
cvr: depth 40

[engines]
prf: smtbmc bitwuzla
cvr: smtbmc yices

[script]
read -define PE_CHIP_FORMAL
read -formal tt_um_sahil_protoemu.v
read -formal pe_host_if.v pe_regs.v pe_imem.v pe_dmem.v pe_fifo.v pe_sync.v pe_pins.v
read -formal pe_ctrl.v pe_decode.v pe_vote.v pe_txu.v pe_rxu.v pe_det.v pe_crc.v
prep -top tt_um_sahil_protoemu

[files]
../src/tt_um_sahil_protoemu.v
../src/host/pe_host_if.v
../src/host/pe_regs.v
../src/mem/pe_imem.v
../src/mem/pe_dmem.v
../src/mem/pe_fifo.v
../src/io/pe_sync.v
../src/io/pe_pins.v
../src/core/pe_ctrl.v
../src/core/pe_decode.v
../src/core/pe_vote.v
../src/unit/pe_txu.v
../src/unit/pe_rxu.v
../src/unit/pe_det.v
../src/unit/pe_crc.v
