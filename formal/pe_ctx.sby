# pe_ctx: ready equation, restart, writeback, stall countdown, vote result
# shift. The pe_core contract (writeback only when ready) is ASSUMED here;
# it is proved separately in pe_core.sby.
[tasks]
default
small

[options]
mode prove
depth 6

[engines]
smtbmc yices

[script]
read -formal -DPE_CTX_TOP pe_ctx.v
default: chparam -set AW 6 -set SR_W 16 -set CTR_W 16 pe_ctx
small: chparam -set AW 4 -set SR_W 10 -set CTR_W 12 pe_ctx
prep -top pe_ctx

[files]
../src/core/pe_ctx.v
