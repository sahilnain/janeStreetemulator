# Tasks c1/c2/c3 use a reduced IMEM and vote widths for speed; `full` uses
# the real chip sizes.
# pe_core with pe_ctx, pe_decode, pe_exec and pe_vote, for ANY instruction
# stream (im_rdata is a free input). Proves the core's own properties AND
# the sub-modules' properties and input contracts together: writeback only
# when ready, one-hot ops reaching exec, slot order, side effects only on
# issue, FIFO safety, no starvation.
[tasks]
c2
c3
c1
full

[options]
mode prove
depth 8

[engines]
smtbmc yices

[script]
read -formal -DPE_CORE_TOP pe_core.v
read -formal pe_ctx.v pe_decode.v pe_exec.v pe_vote.v
c2: chparam -set NUM_CTX 2 -set IMEM_DEPTH 16 -set VOTE_CTX_MASK 3 -set VOTE_N_W 3 -set VOTE_S_W 3 pe_core
c3: chparam -set NUM_CTX 3 -set IMEM_DEPTH 16 -set VOTE_CTX_MASK 5 -set VOTE_N_W 3 -set VOTE_S_W 3 pe_core
full: chparam -set NUM_CTX 2 -set IMEM_DEPTH 64 -set VOTE_CTX_MASK 3 -set VOTE_N_W 4 -set VOTE_S_W 12 pe_core
c1: chparam -set NUM_CTX 1 -set IMEM_DEPTH 16 -set VOTE_CTX_MASK 1 -set VOTE_N_W 3 -set VOTE_S_W 3 pe_core
prep -top pe_core

[files]
../src/core/pe_core.v
../src/core/pe_ctx.v
../src/core/pe_decode.v
../src/core/pe_exec.v
../src/core/pe_vote.v
